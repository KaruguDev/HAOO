# Vite loads .env.<mode> by build mode, so every mode file is the natural place a
# developer drops VITE_HAOO_FORM_ENDPOINT while testing the deploy configuration --
# and anything that lands beside it. Ignore the whole family, keep the checked-in
# example.
.env
.env.*
!.env.example

# Tool-generated worktrees and local agent state. `.claude/worktrees/` holds whole
# duplicate checkouts of this repository, so a routine `git add -A` would otherwise
# commit a second copy of the source tree plus a worktree `.git` pointer file.
.claude/

# Local GSD runtime and generated research cache
.gsd/
.planning/research/.cache/

# Generated owner reports carry aggregate HAOO business counts and are produced on
# demand from the Stats API. They are a local artifact of `npm run report:haoo`, never
# repository content, and must not reach a published bundle or a code review diff.
.reports/

# Throwaway output of the provider-selected ingestion-host bundle probe (src/test/build-output.test.ts)
dist-approved-host-probe/
