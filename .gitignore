# Vite loads .env.<mode> by build mode, so every mode file is the natural place a
# developer drops VITE_HAOO_FORM_ENDPOINT while testing the deploy configuration --
# and anything that lands beside it. Ignore the whole family, keep the checked-in
# example.
.env
.env.*
!.env.example

# Tool-generated worktrees and local agent state. `.claude/worktrees/` holds whole
# duplicate checkouts of this repository, so a routine `git add -A` would otherwise
# commit a second copy of the source tree plus a worktree `.git` pointer file.
.claude/

# Local GSD runtime and generated research cache
.gsd/
.planning/research/.cache/

# Generated owner reports carry aggregate HAOO business counts and are produced on
# demand from the Stats API. They are a local artifact of `npm run report:haoo`, never
# repository content, and must not reach a published bundle or a code review diff.
.reports/

# Throwaway output of the two bundle probes in src/test/build-output.test.ts: one built
# with the provider selected, one with it blanked. Both cases remove their directory in a
# `finally` block, so these rules are the belt to that braces -- a run interrupted between
# the build and the cleanup would otherwise leave a whole untracked dist tree behind.
dist-approved-host-probe/
dist-provider-unset-probe/

# Playwright run scratch. `.playwright-report/` holds the generated HTML report (a bundled
# viewer plus per-run assets) and `.playwright-results/` holds per-test attachments, traces
# and failure screenshots. Both are regenerated by every run and neither is repository
# content. They are dot-directories so the ESLint sweep does not walk them either.
# `evidence/` is deliberately NOT ignored: the measured values there are the phase's product.
.playwright-report/
.playwright-results/

# The Playwright JSON reporter's own run record. `evidence/` is otherwise committed -- the
# measured values there are the phase's product -- but this ONE generated file is not, and the
# exclusion is a threat-model requirement rather than tidiness: T-05-13 accepts the residual
# risk of a committed `evidence/*.json` explicitly on the basis that it "carries URLs, status
# codes, rule ids and measurements only". This reporter output instead embeds absolute local
# filesystem paths (the checkout's home directory, the resolved node binary), which is neither
# of those, and it is rewritten by every run. `evidence/tracer.json` is written by the spec
# itself and carries measurements only, so it stays committed.
evidence/playwright-run.json
